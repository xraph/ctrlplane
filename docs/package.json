{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check --error-on-warnings",
    "format": "biome format --write"
  },
  "dependencies": {
    "fumadocs-core": "16.8.5",
    "fumadocs-mdx": "14.3.2",
    "fumadocs-ui": "16.8.5",
    "lucide-react": "^0.564.0",
    "next": "16.3.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "@biomejs/biome": "^2.4.1"
  },
  "packageManager": "pnpm@10.34.6",
  "pnpm": {
    "overrides": {
      "mdast-util-to-markdown": "2.1.2"
    }
  }
}
